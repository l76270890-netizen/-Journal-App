TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
SECRET_KEY=replace-with-a-long-random-secret

FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app

# Local Windows development can leave both Turso values empty and use the
# backend's existing notes.db. Vercel requires both Turso values.
DATABASE_URL=

# Optional welcome email
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
